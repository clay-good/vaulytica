  "findings": [
    {
      "description": "The document references fees but no 'Net X' or 'due within' clause was found.",
      "document_position": 0,
      "excerpt": {
        "end_offset": 0,
        "section_id": "s1",
        "start_offset": 0,
        "text": "(no payment-term clause)"
      },
      "explanation": "Commercial contracts should state when payment is due. 'Net 30' or 'due within X days of invoice' is the typical formulation. Without it, payment timing defaults to the governing-law rule.",
      "id": "FIN-005-s1-0",
